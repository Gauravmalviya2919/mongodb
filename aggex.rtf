{ Count total students }
db.students.aggregate([
  {
    $count: "totalStudents"
  }
])

{ Find average CGPA }
db.students.aggregate([
  {
    $group: {
      _id: null,
      averageCGPA: { $avg: "$cgpa" }
    }
  }
])

{ Find highest CGPA }
db.students.aggregate([
  {
    $group: {
      _id: null,
      highestCGPA: { $max: "$cgpa" }
    }
  }
])

{ Find lowest CGPA }
db.students.aggregate([
  {
    $group: {
      _id: null,
      lowestCGPA: { $min: "$cgpa" }
    }
  }
])

 { Find total fees collected }
db.students.aggregate([
  {
    $group: {
      _id: null,
      totalFees: { $sum: "$fees" }
    }
  }
])

{ Count students by department }

db.students.aggregate([
  {
    $group: {
      _id: "$department",
      totalStudents: { $sum: 1 }
    }
  }
])

 { Average CGPA by department }
db.students.aggregate([
  {
    $group: {
      _id: "$department",
      averageCGPA: { $avg: "$cgpa" }
    }
  }
])

 { Sort students by CGPA }
db.students.aggregate([
  {
    $sort: {
      cgpa: -1
    }
  }
])

{ Students with CGPA greater than 8 }
db.students.aggregate([
  {
    $match: {
      cgpa: { $gt: 8 }
    }
  }
])

{ Count students in each semester }

db.students.aggregate([
  {
    $group: {
      _id: "$semester",
      totalStudents: { $sum: 1 }
    }
  }
])

{ Work with the courses array }
db.students.aggregate([
  {
    $unwind: "$courses"
  }
])

