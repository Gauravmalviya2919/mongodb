\f1 \cf0 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 \{ Count total students \}\
db.students.aggregate([\
  \{\
    $count: "totalStudents"\
  \}\
])\
\
\{ Find average CGPA \}\
db.students.aggregate([\
  \{\
    $group: \{\
      _id: null,\
      averageCGPA: \{ $avg: "$cgpa" \}\
    \}\
  \}\
])\
\
\{ Find highest CGPA \}\
db.students.aggregate([\
  \{\
    $group: \{\
      _id: null,\
      highestCGPA: \{ $max: "$cgpa" \}\
    \}\
  \}\
])\
\
